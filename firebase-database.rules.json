{
  "rules": {
    ".read": false,
    ".write": false,
    "staff": {
      ".read": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('role').val() === 'super_admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'jlcabucos.cec@gmail.com' || (auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['uid','email','status']) && (auth.token.email === 'jlcabucos.cec@gmail.com' || (newData.child('status').val() === 'pending' && newData.child('role').val() !== 'admin' && newData.child('role').val() !== 'super_admin'))"
      }
    },
    "cms": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('role').val() === 'super_admin' || root.child('staff').child(auth.uid).child('role').val() === 'admin')"
    },
    "registrations": {
      ".read": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('status').val() === 'approved')",
      ".write": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('status').val() === 'approved')"
    },
    "staffNotes": {
      ".read": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('status').val() === 'approved')",
      ".write": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('status').val() === 'approved')"
    },
    "liveMatches": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('status').val() === 'approved')"
    },
    "activeMatchId": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('status').val() === 'approved')"
    },
    "brackets": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'jlcabucos.cec@gmail.com' || root.child('staff').child(auth.uid).child('status').val() === 'approved')"
    }
  }
}
